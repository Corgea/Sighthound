(
    rules: [
        (
            id: Some("props-crypto-001"),
            name: Some("Weak Encryption Configuration"),
            category: Some("cryptography"),
            mode: "search",
            patterns: Some([
                "regex:(?i)^\\s*(?:encryption|ssl|tls)\\s*=\\s*false\\s*$",
            ]),
            finding_type: Some("Insecure Communication"),
            severity: Some("High"),
            confidence: Some("High"),
            cwe_id: Some("cwe-319"),
            description: Some("Transport encryption is disabled in configuration"),
            file_types: Some((extensions: Some([".properties", ".props", ".config", ".conf", ".cfg", ".ini", ".env"]))),
            tags: Some(["cryptography", "configuration", "cwe-319"])
        ),
        (
            id: Some("props-verification-001"),
            name: Some("TLS Certificate Verification Disabled"),
            category: Some("cryptography"),
            mode: "search",
            patterns: Some([
                "regex:(?i)^\\s*(?:verify|ssl\\.verify|tls\\.verify)\\s*=\\s*false\\s*$",
            ]),
            finding_type: Some("Improper Certificate Validation"),
            severity: Some("High"),
            confidence: Some("High"),
            cwe_id: Some("cwe-295"),
            description: Some("TLS certificate verification is disabled in configuration"),
            file_types: Some((extensions: Some([".properties", ".props", ".config", ".conf", ".cfg", ".ini", ".env"]))),
            tags: Some(["cryptography", "configuration", "cwe-295"])
        ),
        (
            id: Some("props-debug-001"),
            name: Some("Debug Mode Enabled"),
            category: Some("configuration"),
            mode: "search",
            patterns: Some([
                "regex:(?i)^\\s*(?:debug|debug_mode|debugMode)\\s*=\\s*true\\s*$",
            ]),
            finding_type: Some("Insecure Configuration"),
            severity: Some("Medium"),
            confidence: Some("High"),
            cwe_id: Some("cwe-489"),
            description: Some("Debug mode enabled - may expose sensitive information in production"),
            file_types: Some((extensions: Some([".properties", ".props", ".config", ".conf", ".cfg", ".ini", ".env"]))),
            tags: Some(["configuration", "debug", "information-disclosure", "cwe-489"])
        ),
    ]
)
