(
    rules: [
        (
            id: Some("props-secret-001"),
            name: Some("Hardcoded Password"),
            category: Some("secrets"),
            mode: "search",
            patterns: Some([
                "password=",
                "passwd=",
                "pwd=",
                "pass=",
            ]),
            unless: Some([
                "password=",
                "password=${",
                "password=%",
                "password=$ENV",
                "password=<",
                "password=[",
            ]),
            finding_type: Some("Hardcoded Secret"),
            severity: Some("High"),
            confidence: Some("High"),
