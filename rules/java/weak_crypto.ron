            name: Some("Weak Cryptographic Algorithm"),
            category: Some("crypto"),
            mode: "search",
            patterns: Some([
                "getInstance"
            ]),
            finding_type: Some("Weak Cryptographic Algorithm"),
            severity: Some("Medium"),
            confidence: Some("High"),
            cwe_id: Some("cwe-327"),
            description: Some("Weak hashing/encryption algorithm (MD5, SHA1, DES) used via MessageDigest/Cipher.getInstance."),
