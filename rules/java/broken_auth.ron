            id: Some("java-plaintext-auth"),
            name: Some("Improper Authentication via Plaintext Credentials"),
            category: Some("auth"),
            mode: "search",
            patterns: Some([
                "findByUsernameAndPassword"
            ]),
            finding_type: Some("Improper Authentication"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-287"),
            description: Some("Authentication performed by matching a plaintext password column, with no hashing or brute-force protection."),
            file_types: Some((
