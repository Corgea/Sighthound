(
    rules: [
        // === SEARCH: HTTP basic auth with literal credentials ===
        // NOTE (engine limitation): Search mode only inspects call expressions and keys
        // rules on the called method name. Plain assignments (API_KEY = "...") and secrets
        // passed as keyword args to arbitrary constructors (Foo.new(password: "...")) are
        // therefore NOT reachable. Only credential-bearing calls whose method name is known
        // (basic_auth, http_basic_authenticate_with) can be detected here.
        (
            id: Some("ruby-hardcoded-secret-basic-auth"),
            name: Some("Hardcoded Credentials in basic auth"),
            category: Some("secrets"),
            mode: "search",
            patterns: Some([
                "*basic_auth(\"*\"*,*\"*", "*basic_auth('*'*,*'*",
                "*http_basic_authenticate_with(*password: \"*",
                "*http_basic_authenticate_with(*password: '*",
                "=__sh_fullctx__"
            ]),
            finding_type: Some("Hardcoded Credentials"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-798"),
            description: Some("HTTP basic auth configured with literal credentials. Move credentials to environment variables or Rails credentials."),
            file_types: Some((extensions: Some([".rb"]))),
            tags: Some(["hardcoded-secret", "cwe-798", "cwe-259", "ruby"])
        )
    ]
)
