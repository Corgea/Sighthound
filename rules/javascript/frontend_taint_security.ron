        // ==================== CWE-601: Open Redirect ====================
        (
            id: Some("js-open-redirect-taint-001"),
            name: Some("Open Redirect Vulnerability"),
            category: Some("redirect"),
            mode: "taint",
            
            sources: Some([
                // External/untrusted sources only
                "event.data",              // PostMessage from external sources
                "*.responseText",          // Network responses
                "*.response",              // Network responses  
                "prompt(",                 // User prompts
                "*.value",                 // Form inputs (filtered by conditions)
                
                // URL parameters - but only when accessed for external use
                "new URLSearchParams(window.location.search).get",  // Specific parameter access
                "decodeURIComponent",      // Decoded URL components
                "decodeURI",              // Decoded URLs
                
                // External storage (could be manipulated)
                "localStorage.getItem",    // Only if from external sources
                "sessionStorage.getItem",  // Only if from external sources
                "{ ...localStorage }",     // Spread operator for localStorage
                "...localStorage",         // Spread operator variations
                "Object.entries({ ...localStorage })",  // Object.entries with localStorage
                "Object.entries(localStorage)",         // Object.entries with localStorage
                "Object.keys(localStorage)",            // Object.keys with localStorage
                "Object.values(localStorage)",          // Object.values with localStorage
            ]),
            
            sinks: Some([
                // Direct navigation (high risk)
                "window.location.href",
                "window.location.assign", 
                "window.location.replace",
                "location.href",
                "location.assign",
                "location.replace",
                "window.open",
                
                // External redirects
                "*.href",                  // Link href attributes
                "*.src",                   // Resource sources
                "*.action",                // Form actions
                "*.formAction",            // Form actions
                
                // React/Component state that could be used for redirection
                "*.setState",              // React setState
                "this.setState",           // React setState
                "useState",                // React hooks
                "useReducer",              // React hooks
                "*.dispatch",              // Redux/state management
                
                // Component props that could be used for redirection
                "*.props.*",               // Component props
                "props.*",                 // Component props
                "*.onRedirect",            // Callback props
                "*.onNavigate",            // Callback props
                
                // State management libraries
                "store.dispatch",          // Redux
                "*.commit",                // Vuex
                "*.mutate",                // State mutations
                
                // DOM data attributes that could be used for redirection
                "*.dataset.*",             // Dataset attributes
                "*.setAttribute",          // Setting attributes
                
                // Meta refresh (high risk)
                "*.setAttribute(\"http-equiv\", \"refresh\")"
            ]),
            
            sanitizers: Some([
                // URL validation functions
                "isValidURL",
                "validateURL", 
                "isAllowedURL",
                "whitelistURL",
                "sanitizeURL",
                
                // Domain validation
                "isAllowedDomain",
                "validateDomain",
                "isSameDomain",
                "allowedHosts.includes",
                "whitelist.includes",
                
                // URL construction with validation
                "new URL(",               // URL constructor validates format
                "URL.parse",
                
                // Relative URL enforcement
                "startsWith(\"/\")",       // Relative URLs
                "startsWith(\"./\")",      // Relative URLs
                "isRelativeURL",
                "makeRelative",
                
                // Same-origin checks
                "location.origin",
                "window.location.origin",
                "document.domain",
                
                // Encoding (safe when used properly)
                "encodeURIComponent",
                "encodeURI"
            ]),
            
            finding_type: Some("Open Redirect"),
            severity: Some("Medium"),
            confidence: Some("High"),
            cwe_id: Some("cwe-601"),
            
            description: Some("User-controlled input flows to URL redirection without validation"),
            
            file_types: Some((
                extensions: Some([".js", ".jsx", ".ts", ".tsx"]))),
            
            conditions: Some([
                // Exclude safe internal URL operations
                (
                    field: "pattern",
                    operator: "not_contains",
                    value: "window.location.search",
                    condition_type: Some("exclude_safe_operations")
                ),
                (
                    field: "pattern", 
                    operator: "not_contains",
                    value: "location.search",
                    condition_type: Some("exclude_safe_operations")
                ),
                (
                    field: "pattern",
                    operator: "not_contains", 
                    value: "location.pathname",
                    condition_type: Some("exclude_safe_operations")
                ),
                (
                    field: "pattern",
                    operator: "not_contains",
                    value: "history.pushState",
                    condition_type: Some("exclude_safe_operations")
                ),
                (
                    field: "pattern",
                    operator: "not_contains",
                    value: "history.replaceState", 
                    condition_type: Some("exclude_safe_operations")
                ),
                (
                    field: "pattern",
                    operator: "not_contains",
                    value: "URLSearchParams(window.location.search)",
                    condition_type: Some("exclude_safe_operations")
                ),
                (
                    field: "pattern",
                    operator: "not_contains",
                    value: "urlParams.toString()",
                    condition_type: Some("exclude_safe_operations")
                ),
                (
                    field: "pattern",
                    operator: "not_contains",
                    value: "encodeURIComponent(",
                    condition_type: Some("exclude_safe_operations")
                )
            ]),
            
            tags: Some(["open-redirect", "cwe-601", "redirect"])
        ),

