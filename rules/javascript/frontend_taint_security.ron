        // ==================== CWE-927: Missing Origin Validation ====================
        (
            id: Some("js-missing-origin-validation-taint-001"),
            name: Some("Missing Origin Validation in postMessage"),
            category: Some("postmessage"),
            mode: "taint",
            
            sources: Some([
                "event.data",
                "e.data", 
                "message.data"
            ]),
            
            sinks: Some([
                // Any usage of postMessage data without origin check
                "eval(",
                "Function(",
                "*.innerHTML",
                "document.write",
                "*.src",
                "*.href",
                "localStorage.setItem",
                "sessionStorage.setItem",
                "window.location",
                "setTimeout(",
                "setInterval(",
                "import("
            ]),
            
            sanitizers: Some([
                // Must include origin validation
                "event.origin ===",
                "event.origin !==", 
                "e.origin ===",
                "e.origin !==",
                "message.origin ===",
                "checkOrigin(",
                "validateOrigin(",
                "isAllowedOrigin(",
                "allowedOrigins.includes",
                "trustedOrigins.includes"
            ]),
            
            finding_type: Some("Missing Origin Validation"),
            severity: Some("High"),
            confidence: Some("High"),
            cwe_id: Some("cwe-346"),
            
            description: Some("postMessage data is processed without validating the message origin"),
            
            file_types: Some((
                extensions: Some([".js", ".jsx", ".ts", ".tsx"]))),
            
            conditions: Some([
                (
                    field: "context",
                    operator: "not_contains",
                    value: "origin",
                    condition_type: Some("in_context")
                )
            ]),
            
            tags: Some(["postmessage", "cwe-927", "origin-validation"])
        ),

        // ==================== CWE-922: Insecure Storage ====================
        (
            id: Some("js-insecure-storage-taint-001"),
            name: Some("Insecure Storage of Sensitive Data"),
            category: Some("storage"),
            mode: "taint",
            
            sources: Some([
