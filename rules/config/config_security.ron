(
    rules: [
        (
            id: Some("config-secret-001"),
            name: Some("Hardcoded Password in Config"),
            category: Some("secrets"),
            mode: "search",
            patterns: Some([
                "\"password\":",
                "'password':",
                "password:",
                "\"passwd\":",
                "'passwd':",
            ]),
            unless: Some([
                "\"$",
                "'$",
                "ENV",
                "SECRET",
                "vault",
            ]),
            finding_type: Some("Hardcoded Secret"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-798"),
            description: Some("Password found in configuration file - use environment variables or secret management"),
            file_types: Some((extensions: Some([".json", ".yaml", ".yml", ".toml", ".xml", ".config", ".conf"]))),
            tags: Some(["secrets", "password", "cwe-798"])
        ),
        (
            id: Some("config-secret-002"),
            name: Some("API Key in Config"),
            category: Some("secrets"),
            mode: "search",
            patterns: Some([
                "\"api_key\":",
                "'api_key':",
                "\"apiKey\":",
                "'apiKey':",
                "api_key:",
                "apiKey:",
            ]),
            unless: Some([
                "\"$",
                "'$",
                "ENV",
                "SECRET",
            ]),
            finding_type: Some("Hardcoded Secret"),
            severity: Some("Critical"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-798"),
            description: Some("API key found in configuration - use environment variables or secret management"),
            file_types: Some((extensions: Some([".json", ".yaml", ".yml", ".toml", ".xml", ".config", ".conf"]))),
            tags: Some(["secrets", "api-key", "cwe-798"])
        ),
        (
            id: Some("config-secret-003"),
            name: Some("Secret Token in Config"),
            category: Some("secrets"),
            mode: "search",
            patterns: Some([
                "\"secret\":",
                "'secret':",
                "\"token\":",
                "'token':",
                "\"access_token\":",
                "'access_token':",
            ]),
            unless: Some([
                "\"$",
                "'$",
                "ENV",
                "SECRET",
                "vault",
            ]),
            finding_type: Some("Hardcoded Secret"),
            severity: Some("Critical"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-798"),
            description: Some("Secret or token found in configuration - use environment variables or secret management"),
            file_types: Some((extensions: Some([".json", ".yaml", ".yml", ".toml", ".xml", ".config", ".conf"]))),
            tags: Some(["secrets", "token", "cwe-798"])
        ),
        (
            id: Some("config-db-001"),
            name: Some("Database Credentials in Config"),
            category: Some("secrets"),
            mode: "search",
            patterns: Some([
                "\"connection_string\":",
                "'connection_string':",
                "\"connectionString\":",
                "'connectionString':",
                "jdbc:",
                "mongodb:",
                "postgresql:",
            ]),
            finding_type: Some("Database Credentials"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-798"),
            description: Some("Database connection information in configuration - ensure credentials are secure"),
            file_types: Some((extensions: Some([".json", ".yaml", ".yml", ".toml", ".xml", ".config", ".conf"]))),
            tags: Some(["secrets", "database", "cwe-798"])
        ),
        (
            id: Some("config-crypto-001"),
            name: Some("SSL/TLS Verification Disabled"),
            category: Some("cryptography"),
            mode: "search",
            patterns: Some([
                "\"verify\": false",
                "'verify': false",
                "verify: false",
                "\"ssl_verify\": false",
                "ssl_verify: false",
                "\"verify_ssl\": false",
                "verify_ssl: false",
            ]),
            finding_type: Some("Insecure Configuration"),
            severity: Some("High"),
            confidence: Some("High"),
            cwe_id: Some("cwe-295"),
            description: Some("SSL/TLS certificate verification disabled - enables man-in-the-middle attacks"),
            file_types: Some((extensions: Some([".json", ".yaml", ".yml", ".toml", ".xml", ".config", ".conf"]))),
            tags: Some(["cryptography", "ssl", "tls", "cwe-295"])
        ),
        (
            id: Some("config-cors-001"),
            name: Some("Permissive CORS Configuration"),
            category: Some("security-misconfiguration"),
            mode: "search",
            patterns: Some([
                "Access-Control-Allow-Origin: *",
                "\"allow_origin\": \"*\"",
                "'allow_origin': '*'",
                "allow_origin: \"*\"",
                "allowOrigin: \"*\"",
            ]),
            finding_type: Some("Security Misconfiguration"),
            severity: Some("Medium"),
            confidence: Some("High"),
            cwe_id: Some("cwe-942"),
            description: Some("Permissive CORS policy allows all origins - restrict to specific domains"),
            file_types: Some((extensions: Some([".json", ".yaml", ".yml", ".toml", ".xml", ".config", ".conf"]))),
            tags: Some(["cors", "security-misconfiguration", "cwe-942"])
        ),
        (
            id: Some("config-debug-001"),
            name: Some("Debug Mode Enabled in Config"),
            category: Some("configuration"),
            mode: "search",
            patterns: Some([
                "\"debug\": true",
                "'debug': true",
                "debug: true",
                "\"DEBUG\": true",
                "DEBUG: true",
            ]),
            finding_type: Some("Insecure Configuration"),
            severity: Some("Medium"),
            confidence: Some("High"),
            cwe_id: Some("cwe-489"),
            description: Some("Debug mode enabled - may expose sensitive information in production"),
            file_types: Some((extensions: Some([".json", ".yaml", ".yml", ".toml", ".xml", ".config", ".conf"]))),
            tags: Some(["configuration", "debug", "cwe-489"])
        ),
        (
            id: Some("config-auth-001"),
            name: Some("Weak Authentication Configuration"),
            category: Some("authentication"),
            mode: "search",
            patterns: Some([
                "\"authentication\": false",
                "'authentication': false",
                "authentication: false",
                "\"require_auth\": false",
                "require_auth: false",
            ]),
            finding_type: Some("Security Misconfiguration"),
            severity: Some("Critical"),
            confidence: Some("High"),
            cwe_id: Some("cwe-306"),
            description: Some("Authentication disabled in configuration - ensure proper access control"),
            file_types: Some((extensions: Some([".json", ".yaml", ".yml", ".toml", ".xml", ".config", ".conf"]))),
            tags: Some(["authentication", "authorization", "cwe-306"])
        ),
        (
            id: Some("config-aws-001"),
            name: Some("AWS Credentials in Config"),
            category: Some("secrets"),
            mode: "search",
            patterns: Some([
                "AWS_ACCESS_KEY_ID",
                "AWS_SECRET_ACCESS_KEY",
                "aws_access_key_id",
                "aws_secret_access_key",
            ]),
            finding_type: Some("Hardcoded Secret"),
            severity: Some("Critical"),
            confidence: Some("High"),
            cwe_id: Some("cwe-798"),
            description: Some("AWS credentials in configuration - use IAM roles or AWS Secrets Manager"),
            file_types: Some((extensions: Some([".json", ".yaml", ".yml", ".toml", ".xml", ".config", ".conf"]))),
            tags: Some(["secrets", "aws", "credentials", "cwe-798"])
        ),
        (
            id: Some("config-http-001"),
            name: Some("HTTP URL in Config"),
            category: Some("cryptography"),
            mode: "search",
            patterns: Some([
                "\"http://",
                "'http://",
                "http://",
            ]),
            unless: Some([
                "localhost",
                "127.0.0.1",
                "http://example",
            ]),
            finding_type: Some("Insecure Communication"),
            severity: Some("Medium"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-319"),
            description: Some("HTTP URL found - use HTTPS for secure communication"),
            file_types: Some((extensions: Some([".json", ".yaml", ".yml", ".toml", ".xml", ".config", ".conf"]))),
            tags: Some(["cryptography", "http", "cwe-319"])
        ),
    ]
)

