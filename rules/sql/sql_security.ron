(
    rules: [
        (
            id: Some("sql-unsafe-001"),
            name: Some("Dynamic SQL with EXECUTE"),
            category: Some("sql-injection"),
            mode: "search",
            patterns: Some([
                "regex:(?i)EXECUTE\\s+IMMEDIATE\\s+.*(?:\\|\\||CONCAT\\s*\\(|user|input|param)",
                "regex:(?i)sp_executesql\\s+.*(?:\\+|CONCAT\\s*\\(|user|input|param)",
                "regex:(?i)EXEC(?:UTE)?\\s*\\(.*(?:\\+|\\|\\||user|input|param)",
            ]),
            finding_type: Some("SQL Injection"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-89"),
            description: Some("Dynamic SQL execution can lead to SQL injection if user input is not properly sanitized"),
            file_types: Some((extensions: Some([".sql"]))),
            tags: Some(["sql-injection", "dynamic-sql", "cwe-89"])
        ),
        (
            id: Some("sql-comment-001"),
            name: Some("SQL Comment Injection Pattern"),
            category: Some("sql-injection"),
            mode: "search",
            patterns: Some([
                "' --",
                "\" --",
                "; --",
                "' /*",
                "\" /*",
                "; /*",
                "' #",
                "\" #",
                "; #",
            ]),
            finding_type: Some("SQL Injection"),
            severity: Some("Medium"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-89"),
            description: Some("SQL comment syntax after quotes or semicolons may indicate injection attempt or comment-based attack"),
            file_types: Some((extensions: Some([".sql"]))),
            tags: Some(["sql-injection", "comments", "cwe-89"])
        ),
    ]
)
