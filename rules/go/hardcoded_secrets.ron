// Go hardcoded credentials / secrets rules (CWE-798)
// See sql_injection.ron header for engine/full-context conventions.
//
// LIMITATION: the Go scanner only visits call_expression nodes, so plain
// assignments such as `password := "hunter2"` cannot be flagged. These rules
// therefore target hardcoded secrets that appear *inside* function calls
// (DSNs, HMAC/JWT keys, basic-auth URLs), which is what is observable.
(
    rules: [
        (
            id: Some("go-hardcoded-secret-in-call"),
            name: Some("Hardcoded credential or key material in call"),
            category: Some("secrets"),
            mode: "search",
            patterns: Some([
                // Database DSN with embedded user:password@host.
                "regex:sql\\.Open\\(\\s*\"[^\"]*\"\\s*,\\s*\"[^\"]*:[^\"@/]+@",
                // Hardcoded HMAC / signing key passed as a byte literal.
                "regex:hmac\\.New\\([^)]*\\[\\]byte\\(\\s*\"[^\"]+\"",
                "regex:\\.SignedString\\(\\s*\\[\\]byte\\(\\s*\"[^\"]+\"",
                // Basic-auth credentials baked into a URL literal.
                "regex:\"https?://[^\"/ ]+:[^\"/ @]+@",
                "=__force_full_context__"
            ]),
            finding_type: Some("Hardcoded Credentials"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-798"),
            description: Some("A credential, signing key, or connection secret is hardcoded into the source. Load secrets from environment variables or a secret manager instead."),
            file_types: Some(( extensions: Some([".go"]) )),
            tags: Some(["secrets", "hardcoded-credentials", "cwe-798", "cwe-259", "go"])
        )
    ]
)
