(
    rules: [
        // Path traversal: file-serving / archive-extraction / path-join sinks
        // reachable at a call site (bare dotted/function names).
        (
            id: Some("python-path-001"),
            name: Some("Path Traversal Sink"),
            category: Some("path_traversal"),
            mode: "search",
            patterns: Some([
                "send_file",
                "send_from_directory",
                "safe_join_path",
                "extractall",
            ]),
            finding_type: Some("Path Traversal"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-22"),
            description: Some("File path / archive entry may be attacker-controlled, enabling path traversal"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["path", "traversal", "file"])
        ),

        // Taint: user input flowing into file-system operations. (Also required so
        // the combined scan's taint pass has at least one taint rule to run.)
        (
            id: Some("python-path-taint-001"),
            name: Some("Path Traversal Taint Flow"),
            category: Some("path_traversal"),
            mode: "taint",
            sources: Some([
                "request.",
                "input(",
                "sys.argv",
                "flask.request",
            ]),
            sinks: Some([
                "open(",
                "os.remove",
                "os.unlink",
                "shutil.copy",
                "shutil.move",
            ]),
            sanitizers: Some([
                "secure_filename",
                "os.path.basename",
                // Avoid matching subprocess.Popen via the "open(" sink substring.
                "subprocess",
            ]),
            finding_type: Some("Path Traversal"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-22"),
            description: Some("User input flows to a file-system operation without path validation"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["path", "traversal", "taint", "file"])
        )
    ]
)
