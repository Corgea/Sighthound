(
    rules: [
        // ---- Code injection (eval/exec) ----
        // The "*= eval(*" / "*= exec(*" entries contain "=", which forces the
        // engine to match the whole call text instead of just the function name,
        // so "eval("/"exec(" are tested against the call text (and therefore do
        // NOT match cursor.execute(...), since "exec(" != "execute(").
        (
            id: Some("python-code-001"),
            name: Some("Code Injection via eval/exec"),
            category: Some("code_execution"),
            mode: "search",
            patterns: Some([
                "eval(",
                "exec(",
                "*= eval(*",
                "*= exec(*",
            ]),
            finding_type: Some("Code Injection"),
            severity: Some("Critical"),
            confidence: Some("High"),
            cwe_id: Some("cwe-95"),
            description: Some("Use of eval()/exec() can lead to arbitrary code execution"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["code", "injection", "eval"])
        ),

        // ---- Server-Side Template Injection (jinja2 from_string) ----
        (
            id: Some("python-ssti-001"),
            name: Some("Server-Side Template Injection"),
            category: Some("ssti"),
            mode: "search",
            patterns: Some([
                "from_string",
            ]),
            finding_type: Some("Template Injection"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-94"),
            description: Some("Rendering a template built from untrusted input (jinja2 Environment.from_string) enables SSTI/RCE"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["ssti", "template", "injection"])
        ),

        // ---- Dynamic import ----
        (
            id: Some("python-code-003"),
            name: Some("Dynamic Import"),
            category: Some("dynamic_import"),
            mode: "search",
            patterns: Some([
                "__import__",
                "importlib.import_module",
            ]),
            finding_type: Some("Dynamic Import"),
            severity: Some("Medium"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-95"),
            description: Some("Dynamic imports can be dangerous if user input is involved"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["import", "dynamic", "security"])
        ),

        // ---- Deserialization ----
        (
            id: Some("python-deser-001"),
            name: Some("Unsafe Deserialization"),
            category: Some("deserialization"),
            mode: "search",
            patterns: Some([
                "pickle.loads",
                "pickle.load",
                "cPickle.loads",
                "cPickle.load",
                "yaml.load",
                "yaml.unsafe_load",
                "marshal.loads",
                "dill.loads",
            ]),
            finding_type: Some("Unsafe Deserialization"),
            severity: Some("Critical"),
            confidence: Some("High"),
            cwe_id: Some("cwe-502"),
            description: Some("Unsafe deserialization of untrusted data can lead to RCE"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["deserialization", "pickle", "yaml", "unsafe"])
        ),

        // ---- SSRF ----
        (
            id: Some("python-ssrf-001"),
            name: Some("Server-Side Request Forgery"),
            category: Some("ssrf"),
            mode: "search",
            patterns: Some([
                "requests.get",
                "requests.post",
                "requests.put",
                "requests.delete",
                "requests.patch",
                "requests.head",
                "requests.request",
                "urllib.request.urlopen",
                "urllib.urlopen",
                "httpx.get",
                "httpx.post",
            ]),
            finding_type: Some("SSRF"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-918"),
            description: Some("Outbound HTTP request sink; if the URL is attacker-controlled this is SSRF"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["ssrf", "request"])
        ),

        // ---- XXE ----
        (
            id: Some("python-xxe-001"),
            name: Some("XML External Entity Injection"),
            category: Some("xxe"),
            mode: "search",
            patterns: Some([
                "etree.fromstring",
                "etree.parse",
                "etree.XMLParser",
                "minidom.parse",
                "minidom.parseString",
                "sax.parse",
                "pulldom.parse",
            ]),
            finding_type: Some("XXE"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-611"),
            description: Some("XML parsing without disabling external entities can lead to XXE"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["xxe", "xml"])
        ),

        // ---- Reflected/stored XSS via server-side template / HTML rendering ----
        (
            id: Some("python-xss-001"),
            name: Some("XSS via Template/HTML Rendering"),
            category: Some("xss"),
            mode: "search",
            patterns: Some([
                "render_template_string",
                "markdown.markdown",
                "HTMLResponse",
                "make_response",
            ]),
            finding_type: Some("Cross-Site Scripting"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-79"),
            description: Some("Untrusted data rendered into HTML without escaping can lead to XSS"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["xss", "html", "template"])
        ),

        // ---- Reflected/stored XSS via f-string-built HTML ----
        // An assignment whose value is an HTML fragment built with interpolation
        // (`{...}`). Evaluated by the Python assignment scanner against the whole
        // statement; the `=` forces full-statement matching and requiring a `{`
        // after the tag keeps static HTML literals from matching. Untrusted data
        // glued into markup like this is returned to the client (render_template_string,
        // jsonify'd *_html fields, etc.) without escaping.
        (
            id: Some("python-xss-002"),
            name: Some("XSS via Interpolated HTML String"),
            category: Some("xss"),
            mode: "search",
            patterns: Some([
                "*=*<div*{*",
                "*=*<p>*{*",
                "*=*<p *{*",
                "*=*<h1*{*",
                "*=*<h2*{*",
                "*=*<span*{*",
                "*=*<html*{*",
                "*=*<body*{*",
                "*=*<a href*{*",
                "*=*<img*{*",
            ]),
            finding_type: Some("Cross-Site Scripting"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-79"),
            description: Some("HTML markup built from interpolated values; if any value is attacker-controlled this is reflected/stored XSS"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["xss", "html", "injection"])
        ),

        // ---- Open redirect ----
        (
            id: Some("python-redirect-001"),
            name: Some("Open Redirect"),
            category: Some("redirect"),
            mode: "search",
            patterns: Some([
                "RedirectResponse",
            ]),
            finding_type: Some("Open Redirect"),
            severity: Some("Medium"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-601"),
            description: Some("Redirect target may be attacker-controlled (open redirect)"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["redirect", "open-redirect"])
        ),

        // ---- Debug mode / interactive debugger exposed ----
        (
            id: Some("python-debug-001"),
            name: Some("Debug Mode Enabled"),
            category: Some("misconfiguration"),
            mode: "search",
            patterns: Some([
                "*app.run(*debug=True*",
                "*.run(*debug=True*",
            ]),
            finding_type: Some("Debug Mode Enabled"),
            severity: Some("Medium"),
            confidence: Some("High"),
            cwe_id: Some("cwe-489"),
            description: Some("Flask/served app started with debug=True exposes the interactive debugger"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["debug", "misconfiguration"])
        ),
        (
            id: Some("python-debug-002"),
            name: Some("Werkzeug Interactive Debugger Exposed"),
            category: Some("misconfiguration"),
            mode: "search",
            patterns: Some([
                "*run_simple(*use_debugger=True*",
                "*run_simple(*use_reloader=True*",
            ]),
            finding_type: Some("Interactive Debugger Exposed"),
            severity: Some("Critical"),
            confidence: Some("High"),
            cwe_id: Some("cwe-94"),
            description: Some("Werkzeug run_simple with the interactive debugger enables remote code execution"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["debug", "rce", "misconfiguration"])
        ),
    ]
)
