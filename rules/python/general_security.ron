(
    rules: [
        // Code injection vulnerabilities
        (
            id: Some("python-code-001"),
            name: Some("Code Injection via eval()"),
            category: Some("injection"),
            mode: "search",
            patterns: Some([
                "eval\\(",
            ]),
            finding_type: Some("Code Injection"),
            severity: Some("Critical"),
            confidence: Some("High"),
            cwe_id: Some("cwe-95"),
            description: Some("Use of eval() can lead to arbitrary code execution"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["code", "injection", "eval"])
        ),
        (
            id: Some("python-code-002"),
            name: Some("Code Injection via exec()"),
            category: Some("injection"),
            mode: "search",
            patterns: Some([
                "exec\\(",
            ]),
            finding_type: Some("Code Injection"),
            severity: Some("Critical"),
            confidence: Some("High"),
            cwe_id: Some("cwe-95"),
            description: Some("Use of exec() can lead to arbitrary code execution"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["code", "injection", "exec"])
        ),
        (
            id: Some("python-code-003"),
            name: Some("Dynamic Import"),
            category: Some("injection"),
            mode: "search",
            patterns: Some([
                "__import__\\(",
                "importlib\\.import_module\\(",
            ]),
            finding_type: Some("Dynamic Import"),
            severity: Some("Medium"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-95"),
            description: Some("Dynamic imports can be dangerous if user input is involved"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["import", "dynamic", "security"])
        ),
        
        // Deserialization vulnerabilities
        (
            id: Some("python-deser-001"),
            name: Some("Unsafe Pickle Deserialization"),
            category: Some("deserialization"),
            mode: "search",
            patterns: Some([
                "pickle\\.loads\\(",
                "pickle\\.load\\(",
                "cPickle\\.loads\\(",
                "cPickle\\.load\\(",
                "_pickle\\.loads\\(",
            ]),
            finding_type: Some("Unsafe Deserialization"),
            severity: Some("Critical"),
            confidence: Some("High"),
            cwe_id: Some("cwe-502"),
            description: Some("Pickle deserialization is unsafe with untrusted data"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["pickle", "deserialization", "unsafe"])
        ),
        (
            id: Some("python-deser-002"),
            name: Some("Unsafe YAML Deserialization"),
            category: Some("deserialization"),
            mode: "search",
            patterns: Some([
                "yaml\\.load\\(",
                "yaml\\.unsafe_load\\(",
            ]),
            finding_type: Some("Unsafe Deserialization"),
            severity: Some("High"),
            confidence: Some("High"),
            cwe_id: Some("cwe-502"),
            description: Some("YAML load() is unsafe, use safe_load() instead"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["yaml", "deserialization", "unsafe"])
        ),
        
        // HTTP security
        (
            id: Some("python-http-001"),
            name: Some("HTTP Request without SSL Verification"),
            category: Some("http_security"),
            mode: "search",
            patterns: Some([
                "requests\\..*verify=False",
                "urllib.*verify=False",
                "ssl\\._create_unverified_context",
            ]),
            finding_type: Some("SSL Verification Disabled"),
            severity: Some("Medium"),
            confidence: Some("High"),
            cwe_id: Some("cwe-295"),
            description: Some("SSL certificate verification is disabled"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["ssl", "verification", "http"])
        ),
        (
            id: Some("python-http-002"),
            name: Some("HTTP URLs in Production"),
            category: Some("http_security"),
            mode: "search",
            patterns: Some([
                "http://.*",
                "'http://.*'",
                "\"http://.*\"",
            ]),
            finding_type: Some("Insecure HTTP URL"),
            severity: Some("Low"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-319"),
            description: Some("HTTP URLs should be HTTPS in production"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["http", "insecure", "url"])
        ),
        
        // Information disclosure
        (
            id: Some("python-info-001"),
            name: Some("Debug Mode Enabled"),
            category: Some("information_disclosure"),
            mode: "search",
            patterns: Some([
                "debug\\s*=\\s*True",
                "DEBUG\\s*=\\s*True",
                "app\\.debug\\s*=\\s*True",
            ]),
            finding_type: Some("Debug Mode Enabled"),
            severity: Some("Medium"),
            confidence: Some("High"),
            cwe_id: Some("cwe-489"),
            description: Some("Debug mode should be disabled in production"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["debug", "production", "disclosure"])
        ),
        (
            id: Some("python-info-002"),
            name: Some("Exception Information Disclosure"),
            category: Some("information_disclosure"),
            mode: "search",
            patterns: Some([
                "traceback\\.print_exc\\(",
                "traceback\\.format_exc\\(",
                "raise.*Exception\\(.*\\)",
            ]),
            finding_type: Some("Information Disclosure"),
            severity: Some("Low"),
            confidence: Some("Low"),
            cwe_id: Some("cwe-209"),
            description: Some("Exception handling may disclose sensitive information"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["exception", "disclosure", "traceback"])
        ),
        
        // Taint flows for code injection
        (
            id: Some("python-code-taint-001"),
            name: Some("Code Injection Taint Flow"),
            category: Some("injection"),
            mode: "taint",
            sources: Some([
                "request.*",
                "request\\.args\\.",
                "request\\.form\\.",
                "request\\.json\\.",
                "input\\(",
                "sys\\.argv",
                "os\\.environ",
                "flask\\.request",
                "django\\.request",
            ]),
            sinks: Some([
                "eval\\(",
                "exec\\(",
                "compile\\(",
                "__import__\\(",
                "importlib\\.import_module",
            ]),
            sanitizers: Some([
                "escape\\(",
                "quote\\(",
                "sanitize\\(",
                "validate\\(",
            ]),
            finding_type: Some("Code Injection via Taint Flow"),
            severity: Some("Critical"),
            confidence: Some("High"),
            cwe_id: Some("cwe-95"),
            description: Some("User input flows to code execution functions without proper validation"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["code", "injection", "taint", "eval"])
        ),
        
        // Taint flows for deserialization
        (
            id: Some("python-deser-taint-001"),
            name: Some("Unsafe Deserialization Taint Flow"),
            category: Some("deserialization"),
            mode: "taint",
            sources: Some([
                "request.*",
                "request\\.data",
                "request\\.json",
                "input\\(",
                "sys\\.argv",
                "os\\.environ",
                "flask\\.request",
                "django\\.request",
            ]),
            sinks: Some([
                "pickle\\.loads",
                "pickle\\.load",
                "cPickle\\.loads",
                "yaml\\.load",
                "yaml\\.unsafe_load",
            ]),
            finding_type: Some("Unsafe Deserialization via Taint Flow"),
            severity: Some("Critical"),
            confidence: Some("High"),
            cwe_id: Some("cwe-502"),
            description: Some("User input flows to unsafe deserialization functions"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["deserialization", "taint", "pickle", "yaml"])
        )
    ]
) 