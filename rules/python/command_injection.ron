(
    rules: [
        // Search mode rules for command injection patterns
        (
            id: Some("python-cmd-injection-001"),
            name: Some("OS Command Execution"),
            category: Some("injection"),
            mode: "search",
            patterns: Some([
                "os\\.system\\(",
                "os\\.popen\\(",
                "os\\.spawn.*\\(",
                "subprocess\\.call\\(",
                "subprocess\\.run\\(",
                "subprocess\\.Popen\\(",
                "subprocess\\.check_output\\(",
                "subprocess\\.check_call\\(",
            ]),
            finding_type: Some("Command Injection"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-78"),
            description: Some("Command execution detected - verify input is properly sanitized"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["command", "injection", "os"])
        ),
        (
            id: Some("python-cmd-injection-002"),
            name: Some("Shell Command with String Formatting"),
            category: Some("injection"),
            mode: "search",
            patterns: Some([
                "system.*%.*",
                "system.*format.*",
                "popen.*%.*",
                "popen.*format.*",
                "call.*%.*",
                "call.*format.*",
                "run.*%.*",
                "run.*format.*",
            ]),
            finding_type: Some("Command Injection"),
            severity: Some("Critical"),
            confidence: Some("High"),
            cwe_id: Some("cwe-78"),
            description: Some("Command constructed using string formatting, highly vulnerable to injection"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["command", "injection", "shell"])
        ),
        (
            id: Some("python-cmd-injection-003"),
            name: Some("Shell Command with Concatenation"),
            category: Some("injection"),
            mode: "search",
            patterns: Some([
                "system.*\\+.*",
                "popen.*\\+.*",
                "call.*\\+.*",
                "run.*\\+.*",
                "Popen.*\\+.*",
            ]),
            finding_type: Some("Command Injection"),
            severity: Some("High"),
            confidence: Some("High"),
            cwe_id: Some("cwe-78"),
            description: Some("Command constructed using string concatenation, vulnerable to injection"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["command", "injection", "shell"])
        ),
        
        // Taint mode rules for command injection data flows
        (
            id: Some("python-cmd-taint-001"),
            name: Some("Command Injection Taint Flow"),
            category: Some("injection"),
            mode: "taint",
            sources: Some([
                "request.*",
                "request\\.args\\.",
                "request\\.form\\.",
                "request\\.json\\.",
                "input\\(",
                "sys\\.argv",
                "os\\.environ",
                "flask\\.request",
                "django\\.request",
                "raw_input\\(",
            ]),
            sinks: Some([
                "os\\.system",
                "os\\.popen",
                "os\\.spawn",
                "subprocess\\.call",
                "subprocess\\.run",
                "subprocess\\.Popen",
                "subprocess\\.check_output",
                "subprocess\\.check_call",
                "exec\\(",
                "eval\\(",
            ]),
            sanitizers: Some([
                "shlex\\.quote",
                "pipes\\.quote",
                "escape\\(",
                "sanitize\\(",
                "validate\\(",
            ]),
            finding_type: Some("Command Injection via Taint Flow"),
            severity: Some("Critical"),
            confidence: Some("High"),
            cwe_id: Some("cwe-78"),
            description: Some("User input flows directly to command execution without proper sanitization"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["command", "injection", "taint", "shell"])
        )
    ]
) 