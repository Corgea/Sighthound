(
    rules: [
        // Always-shell command sinks: os.system / os.popen / os.exec* / os.spawn*
        // are inherently a shell/exec of a command string. Bare dotted names are
        // matched against the function name.
        (
            id: Some("python-cmd-injection-001"),
            name: Some("OS Command Execution"),
            category: Some("command_execution"),
            mode: "search",
            patterns: Some([
                "os.system",
                "os.popen",
                "os.spawnl",
                "os.spawnv",
                "os.execl",
                "os.execv",
                "commands.getoutput",
                "pty.spawn",
            ]),
            finding_type: Some("Command Injection"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-78"),
            description: Some("OS command execution sink - verify the command is not built from untrusted input"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["command", "injection", "os"])
        ),

        // subprocess.* only when shell=True (the dangerous form). The "=" in the
        // pattern forces full-call-text matching, so list-arg / no-shell calls
        // (e.g. subprocess.Popen(["notepad.exe"])) do not match.
        (
            id: Some("python-cmd-injection-002"),
            name: Some("Subprocess with shell=True"),
            category: Some("command_execution"),
            mode: "search",
            patterns: Some([
                "*subprocess.call(*shell=True*",
                "*subprocess.run(*shell=True*",
                "*subprocess.Popen(*shell=True*",
                "*subprocess.check_output(*shell=True*",
                "*subprocess.check_call(*shell=True*",
                "*subprocess.getoutput(*",
            ]),
            finding_type: Some("Command Injection"),
            severity: Some("High"),
            confidence: Some("Medium"),
            cwe_id: Some("cwe-78"),
            description: Some("subprocess invoked with shell=True; a shell command built from untrusted input is RCE"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["command", "injection", "subprocess"])
        ),
    ]
)
