(
    rules: [
        // === SEARCH MODE RULE (Pattern-based detection for dangerous keywords) ===
        (
            id: Some("python-sql-dangerous-keywords"),
            name: Some("Dangerous SQL Keywords"),
            category: Some("database"),
            mode: "search",
            patterns: Some([
                "*DROP TABLE*",
                "*DELETE FROM*",
                "*UNION SELECT*",
                "*; DROP*",
                "*; DELETE*",
                "*TRUNCATE*",
                "*ALTER TABLE*",
                "*CREATE TABLE*"
            ]),
            finding_type: Some("Dangerous SQL Keywords"),
            severity: Some("High"),
            confidence: Some("High"),
            cwe_id: Some("cwe-89"),
            description: Some("Dangerous SQL keywords detected that could indicate SQL injection attempts or malicious queries"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["sql", "dangerous", "injection", "keywords"])
        ),

        // === COMPREHENSIVE TAINT RULE (General SQL injection data flows) ===
        (
            id: Some("python-sql-injection-comprehensive-taint"),
            name: Some("SQL Injection via Data Flow Analysis"),
            category: Some("database"),
            mode: "taint",
            sources: Some([
                // Web framework request data (comprehensive with wildcards)
                "request.*",
                // Direct user input
                "input(",
                "raw_input("
            ]),
            sinks: Some([
                // All SQL execution methods (comprehensive pattern)
                "*execute*"
            ]),
            finding_type: Some("SQL Injection Data Flow"),
            severity: Some("Critical"),
            confidence: Some("High"),
            cwe_id: Some("cwe-89"),
            description: Some("User input flows to SQL execution without proper sanitization, creating SQL injection vulnerability"),
            file_types: Some((
                extensions: Some([".py"])
            )),
            tags: Some(["sql", "injection", "taint", "database", "critical", "data-flow"])
        ),

    ]
)